<div class="card shadow-sm mb-4">
  <div class="card-header bg-white">
    <h2 class="h5 mb-0">
      <i class="fas <%= @category.new_record? ? 'fa-plus-circle' : 'fa-edit' %> me-2 text-primary"></i>
      <%= @category.new_record? ? 'New Category' : 'Edit Category' %>
    </h2>
  </div>
  <div class="card-body">
    <%= form_with model: [:admin, @category], local: true do |f| %>
      <div class="mb-3">
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, class: 'form-control', required: true %>
      </div>

      <% if params[:parent_id].present? %>
        <%= f.hidden_field :parent_id, value: params[:parent_id] %>
        <div class="alert alert-info mb-4">
          <i class="fas fa-info-circle me-2"></i>
          This will be created as a subcategory of <strong><%= Category.find(params[:parent_id]).name %></strong>
        </div>
      <% else %>
        <div class="mb-4">
          <%= f.label :parent_id, 'Category Type', class: "form-label" %>
          <div class="form-text mb-2">Select parent category to make this a subcategory</div>
          <%= f.collection_select :parent_id, 
                                Category.main_categories.where.not(id: @category.id),
                                :id, :name, 
                                { include_blank: "None (Make this a main category)" }, 
                                { class: 'form-select' } %>
        </div>
      <% end %>

      <div class="d-flex justify-content-end gap-2 mt-4">
        <%= link_to "Cancel", admin_categories_path, class: "btn btn-secondary" %>
        <%= f.submit @category.new_record? ? 'Create Category' : 'Update Category', 
                    class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>
