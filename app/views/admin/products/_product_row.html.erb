<tr id="product_row_<%= product.id %>">
  <td class="text-muted"><%= @products.find_index(product) + 1 rescue product.id %></td>
  <td><strong><%= product.name %></strong></td>
  <td><small class="text-muted"><%= truncate(product.description, length: 50) %></small></td>
  <td class="text-success"><strong><%= number_to_currency(product.price, unit: "MMK") %></strong></td>
  <td>
    <div class="btn-group btn-group-sm" role="group">
      <%= link_to admin_product_path(product),
                  class: "btn btn-light border",
                  title: "View Details",
                  data: { bs_toggle: "tooltip" } do %>
        <i class="fas fa-eye text-primary"></i>
      <% end %>

      <%= link_to edit_admin_product_path(product),
                  class: "btn btn-light border",
                  title: "Edit Product",
                  data: { bs_toggle: "tooltip" } do %>
        <i class="fas fa-edit text-success"></i>
      <% end %>

      <% if product.can_be_deleted? %>
        <%= button_to admin_product_path(product),
                      method: :delete,
                      form: { class: "d-inline", data: { turbo_confirm: "Are you sure you want to delete this product?" } },
                      class: "btn btn-light border",
                      title: "Delete Product",
                      data: { bs_toggle: "tooltip" } do %>
          <i class="fas fa-trash-alt text-danger"></i>
        <% end %>
      <% else %>
       <%= button_to archive_admin_product_path(product),
              method: :patch,
              form: {
                class: "d-inline",
                data: {
                  turbo_stream: true,
                  turbo_confirm: product.archived? ? "Unarchive this product?" : "Archive this product?"
                }
              },
              class: "btn btn-sm #{product.archived? ? 'btn-success' : 'btn-warning'}",
              title: product.archived? ? "Unarchive Product" : "Archive Product",
              data: { bs_toggle: "tooltip" } do %>
        <% if product.archived? %>
          <i class="fas fa-box-open"></i>
          
        <% else %>
          <i class="fas fa-archive"></i>
          
        <% end %>
      <% end %>
      <% end %>
    </div>
  </td>
</tr>
