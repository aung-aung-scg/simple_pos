<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container">
    <%= link_to root_path, class: "navbar-brand" do %>
      <i class="fas fa-clover clover-icon me-2"></i>
      <span class="brand-text">Clover Queen</span>
    <% end %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <% if current_user %>
          <% unless current_user.admin? %>
            <li class="nav-item me-3">
              <%= link_to cart_pos_path, class: "nav-link position-relative p-2 text-nowrap" do %>
                <div class="d-flex align-items-center position-relative">
                  <i class="bi bi-cart3 fs-4"></i>
                  <span class="ms-2 d-none d-lg-inline">Cart</span>
                  <% count = Array(session[:cart]).sum { |_,v| v.to_i } %>
                  <% if count > 0 %>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-badge">
                      <%= count %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </li>
          <% end %>

          <li class="nav-item me-3">
            <%= link_to orders_path, class: "nav-link" do %>
              <i class="bi bi-bag-check me-1"></i>
              <span>Orders</span>
            <% end %>
          </li>

          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
              <i class="bi bi-person-circle me-1"></i>
              <span>Account</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end mt-2">
              <li>
                <%= link_to edit_user_registration_path, class: "dropdown-item" do %>
                  <i class="bi bi-person-gear me-2"></i> My Profile
                <% end %>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= link_to destroy_user_session_path, method: :delete, class: "dropdown-item text-danger" do %>
                  <i class="bi bi-box-arrow-right me-2"></i> Logout
                <% end %>
              </li>
            </ul>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to new_user_session_path, class: "btn btn-outline-light me-2" do %>
              <i class="bi bi-box-arrow-in-right me-1"></i> Login
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to new_user_registration_path, class: "btn btn-primary" do %>
              <i class="bi bi-person-plus me-1"></i> Register
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<style>
.navbar {
  background: linear-gradient(135deg, #2c3e50, #1a1a2e);
  box-shadow: 0 2px 15px rgba(0,0,0,0.1);
  padding: 0.8rem 0;
}

/* Brand Logo */
.navbar-brand {
  transition: transform 0.3s ease;
  display: flex;
  align-items: center;
}

.navbar-brand:hover {
  transform: scale(1.03);
  text-decoration: none;
}

.clover-icon {
  color: #28a745;
  font-size: 1.5rem;
  transition: all 0.3s ease;
}

.brand-text {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: #aad6aa;
}

/* Nav Links */
.nav-link {
  padding: 0.5rem 1rem;
  border-radius: 4px;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  color: rgba(255,255,255,0.85);
}

.nav-link:hover {
  background-color: rgba(255,255,255,0.1);
  color: white;
  text-decoration: none;
}

/* Cart Badge */
.cart-badge {
  transform: translate(10%, -50%);
}

/* Dropdown Menu */
.dropdown-menu {
  border: none;
  box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  border-radius: 8px;
  background-color: #2c3e50;
}

.dropdown-item {
  padding: 0.5rem 1.5rem;
  display: flex;
  align-items: center;
  color: rgba(255,255,255,0.85);
}

.dropdown-item:hover {
  background-color: rgba(255,255,255,0.1);
  color: white;
}

/* Mobile Styles */
@media (max-width: 992px) {
  .navbar-nav {
    padding-top: 1rem;
  }
  
  .nav-item {
    margin-bottom: 0.5rem;
  }
  
  .btn {
    width: 100%;
    margin-bottom: 0.5rem;
  }
}
</style>
