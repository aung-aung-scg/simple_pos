<h1 class="mb-4 text-center">Your Cart</h1>

<% if @variants.empty? %>
  <div class="text-center py-5 bg-light rounded-3">
    <p class="fs-4 text-muted mb-4">Your cart is empty</p>
    <%= link_to "Continue Shopping", pos_path, class: "btn btn-primary btn-lg px-4 py-2" %>
  </div>
<% else %>
  <div class="table-responsive" data-controller="cart">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th style="width:120px">Product</th>
          <th>Details</th>
          <th style="width:150px">Price</th>
          <th style="width:180px">Quantity</th>
          <th style="width:120px">Subtotal</th>
          <th style="width:80px"></th>
        </tr>
      </thead>
      <tbody>
        <% @variants.each do |variant| %>
          <%= render partial: "cart_row", locals: { variant: variant } %>
        <% end %>
      </tbody>
      <tfoot class="table-group-divider">
        <tr>
          <td colspan="4" class="text-end fw-bold">Total:</td>
          <td id="cart-total" class="fw-bold fs-5 text-primary">
            <%= number_with_delimiter(@total) %>MMK
          </td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="d-flex justify-content-between mt-4 gap-3">
    <%= link_to "← Continue Shopping", pos_path, class: "btn btn-outline-primary px-4 py-2 flex-grow-1" %>
    <%= button_to "Proceed to Checkout →", prepare_checkout_pos_path, method: :post, class: "btn btn-success px-4 py-2 flex-grow-1" %>
  </div>
<% end %>

<style>
  .btn { border-width: 2px; font-weight: 500; }
  .btn-outline-primary { color: #0d6efd; border-color: #0d6efd; }
  .btn-outline-primary:hover { color: #fff; background-color: #0d6efd; }
  .btn-primary { background-color: #0d6efd; border-color: #0d6efd; }
  .btn-danger { background-color: #dc3545; border-color: #dc3545; }
</style>
