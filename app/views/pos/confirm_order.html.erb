<div class="container py-5">
  <h1 class="mb-4 text-center">Order Confirmation</h1>

  <div class="row">
    <!-- Order Summary -->
    <div class="col-lg-6 mb-4">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">Order Summary</h5>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Qty</th>
                  <th class="text-end">Price</th>
                </tr>
              </thead>
              <tbody>
                <% @variants.each do |variant| %>
                  <tr>
                    <td>
                      <%= variant.product.name %><br>
                      <small class="text-muted"><%= variant.color %> / <%= variant.size %></small>
                    </td>
                    <td><%= session[:cart][variant.id.to_s] %></td>
                    <td class="text-end">MMK <%= number_with_delimiter(variant.product.price * session[:cart][variant.id.to_s]) %></td>
                  </tr>
                <% end %>
              </tbody>
              <tfoot>
                <tr>
                  <th colspan="2">Total</th>
                  <th class="text-end">MMK <%= number_with_delimiter(@total) %></th>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Customer & Payment Info -->
    <div class="col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h5 class="mb-0">Customer Information</h5>
        </div>
        <div class="card-body">
          <%= form_with url: checkout_pos_path, method: :post, local: true do |f| %>
            <div class="mb-3">
              <label class="form-label">Name</label>
              <%= text_field_tag :name, current_user.name, class: "form-control", required: true %>
            <div class="mb-3">
              <label class="form-label">Phone Number</label>
              <%= text_field_tag :phone, current_user.phone, class: "form-control", required: true %>
            </div>

            <div class="mb-3">
              <label class="form-label">Delivery Address</label>
              <%= text_area_tag :address, current_user.address, class: "form-control", rows: 3, required: true %>
            </div>

            <div class="mb-4">
              <label class="form-label">Payment Method</label>

              <div class="form-check mb-2">
                <%= radio_button_tag :payment_method, "cod", true, class: "form-check-input", id: "payment_cod" %>
                <label class="form-check-label" for="payment_cod">
                  Cash on Delivery (COD)
                </label>
              </div>

              <div class="form-check mb-2">
                <%= radio_button_tag :payment_method, "scan", false, class: "form-check-input", id: "payment_scan" %>
                <label class="form-check-label" for="payment_scan">
                  Scan to Pay
                </label>
              </div>

              <div id="scan_details" class="mt-3" style="display: none;">
                <div class="mb-3">
                  <label class="form-label">Select Payment Provider</label>
                  <select class="form-select" id="payment_provider">
                    <option value="kbz" selected>KBZ Pay</option>
                    <option value="wave">WavePay</option>
                    <option value="cb">CB Pay</option>
                  </select>
                </div>

                <div class="qr-box p-3 bg-light border rounded">
                  <div id="kbz_qr" class="qr-code" style="display: none;">
                    <p class="mb-2">Scan KBZ Pay QR Code:</p>
                    <%= image_tag "kbz.jpg", class: "img-fluid", style: "max-width: 200px;" %>
                    <p class="mt-2 mb-0">KBZ Pay Number: <strong>09XXXXXXX</strong></p>
                  </div>

                  <div id="wave_qr" class="qr-code" style="display: none;">
                    <p class="mb-2">Scan WavePay QR Code:</p>
                    <%= image_tag "wave.jpg", class: "img-fluid", style: "max-width: 200px;" %>
                    <p class="mt-2 mb-0">WavePay Number: <strong>09XXXXXXX</strong></p>
                  </div>

                  <div id="cb_qr" class="qr-code" style="display: none;">
                    <p class="mb-2">Scan CB Pay QR Code:</p>
                    <%= image_tag "cb.jpg", class: "img-fluid", style: "max-width: 200px;" %>
                    <p class="mt-2 mb-0">CB Pay Number: <strong>09XXXXXXX</strong></p>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-between">
              <%= link_to "← Back to Cart", cart_pos_path, class: "btn btn-secondary" %>
              <%= f.submit "Confirm Order →", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initPaymentMethods() {
    if (typeof jQuery === 'undefined') {
      setTimeout(initPaymentMethods, 100);
      return;
    }
    
    $(function() {
      $('#payment_provider').change(function() {
        $('.qr-code').hide();
        $('#' + $(this).val() + '_qr').show();
      });
      
      $('input[name="payment_method"]').change(function() {
        if ($(this).val() === 'scan') {
          $('#scan_details').show();
          $('#payment_provider').trigger('change');
        } else {
          $('#scan_details').hide();
        }
      });
      
      // Initialize
      if ($('#payment_scan').is(':checked')) {
        $('#scan_details').show();
        $('#payment_provider').trigger('change');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initPaymentMethods);
  document.addEventListener('turbo:load', initPaymentMethods);
</script>
