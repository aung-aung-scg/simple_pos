<!-- Breadcrumbs -->
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb text-uppercase small">
    <li class="breadcrumb-item text-muted"><%= @product.gender %></li>
    <li class="breadcrumb-item text-muted"><%= @product.category&.name %></li>
    <li class="breadcrumb-item active text-dark" aria-current="page"><%= @product.name %></li>
  </ol>
</nav>

<!-- Product Name -->
<h1 class="h4 fw-bold mb-3 text-uppercase"><%= @product.name %></h1>

<div class="row gy-5 align-items-start">
  <!-- Product Image -->
  <div class="col-lg-6 text-center">
    <% if @variants.first&.image&.attached? %>
      <%= image_tag @variants.first.image.variant(resize_to_limit: [450, 450]), id: "variant-image", alt: @product.name, class: "img-fluid rounded-4 shadow-sm border" %>
    <% else %>
      <div class="d-flex align-items-center justify-content-center bg-light rounded-4 shadow-sm" style="height: 400px;">
        <span class="text-muted fs-5">No Image Available</span>
      </div>
    <% end %>
  </div>

  <!-- Product Options -->
  <div class="col-lg-6">
    <% if @product.description.present? %>
      <div class="mb-4">
        <span class="fs-6 text-muted text-uppercase">Description</span>
        <p id="product-description" class="description collapsed text-secondary mb-0">
          <%= @product.description %>
        </p>
      </div>
    <% end %>

    <!-- Price -->
    <div class="mb-4">
      <span class="fs-6 text-muted text-uppercase">Price</span>
      <p class="fs-2 fw-bold text-dark mb-0">MMK <%= number_with_delimiter(@product.price) %></p>
    </div>

    <%= form_with url: add_to_cart_pos_path, method: :post, local: true, id: "variant-selection-form" do %>
      <!-- Color Selection -->
      <div class="mb-4">
        <label class="form-label fw-semibold ">COLOR: <span id="selected-color" class="text-dark"><%= @variants.first.color%></span></label>
        <div id="color-options" class="d-flex flex-wrap gap-2">
          <% @available_colors.each do |color| %>
            <% variant_with_image = @variants.find { |v| v.color == color && v.image.attached? } %>
            <% image_url = variant_with_image&.image_url || "https://via.placeholder.com/60" %>

            <input type="radio" name="color" id="color-<%= color %>" value="<%= color %>" class="btn-check color-radio" autocomplete="off">
            <label for="color-<%= color %>" class="border rounded p-1" style="cursor: pointer;">
              <%= image_tag image_url, style: "width: 60px; height: 60px; object-fit: cover; border-radius: 0.25rem;" %>
            </label>
          <% end %>
        </div>
        <div class="invalid-feedback d-block text-danger" id="color-error" style="display: none;">Please select a color.</div>
      </div>

      <!-- Size Selection -->
      <div class="mb-4">
        <label class="form-label fw-semibold text-uppercase">Size</label>
        <div id="size-options" class="d-grid gap-2 grid-template-columns" style="grid-template-columns: repeat(auto-fill, minmax(60px, 1fr));"></div>
        <div class="invalid-feedback d-block text-danger" id="size-error" style="display: none;">Please select a size.</div>
      </div>

      <!-- Stock Info -->
      <div id="stock-info" class="mb-3 fs-5 fw-medium text-secondary"></div>

      <%= hidden_field_tag :variant_id, nil, id: "variant-id-field" %>

      <!-- Add to Cart -->
      <button type="submit" class="btn btn-dark btn-lg w-100 text-uppercase" id="add-to-cart-btn" disabled>
        Add to Cart
      </button>
    <% end %>
  </div>
</div>

<!-- jQuery Script -->
<script>
function initializeVariantSelection() {
  if (typeof jQuery === 'undefined') {
    setTimeout(initializeVariantSelection, 100);
    return;
  }

  if ($('#color-options').length === 0) return;

  const variants = <%= raw @variants.to_json(only: [:id, :color, :size, :stock], methods: [:image_url]) %>;

  function clearSelection() {
    $('#stock-info').text('');
    $('#variant-id-field').val('');
    $('#add-to-cart-btn').prop('disabled', true);
  }

  function updateSizes(color, autoSelectFirst = false) {
    const filtered = variants.filter(v => v.color === color);
    const uniqueSizes = [...new Set(filtered.map(v => v.size).filter(s => s))];
    const $sizeContainer = $('#size-options');

    $sizeContainer.empty();

    if (uniqueSizes.length > 0) {
      $sizeContainer.closest('.mb-4').show();
      uniqueSizes.forEach(size => {
        const inputId = `size-${size}`;
        $sizeContainer.append(`
          <input type="radio" name="size" id="${inputId}" class="btn-check size-radio" value="${size}" autocomplete="off">
          <label class="btn btn-outline-secondary" for="${inputId}">${size}</label>
        `);
      });
      if (autoSelectFirst) $(`#size-${uniqueSizes[0]}`).prop('checked', true).trigger('change');
    } else {
      $sizeContainer.closest('.mb-4').hide();
      $('#variant-id-field').val(filtered[0]?.id || '');
      $('#add-to-cart-btn').prop('disabled', filtered[0]?.stock <= 0);
      $('#stock-info').text(`Stock: ${filtered[0]?.stock || 0}`);
    }

    const firstImageVariant = filtered.find(v => v.image_url);
    if (firstImageVariant) $('#variant-image').attr('src', firstImageVariant.image_url);

    $sizeContainer.off('change', '.size-radio').on('change', '.size-radio', function() {
      const selectedSize = $(this).val();
      const selectedColor = $('.color-radio:checked').val();
      if (selectedColor) updateStock(selectedColor, selectedSize);
      $('#size-error').hide();
    });
  }

  function updateStock(color, size) {
    const variant = variants.find(v => v.color === color && (v.size === size || size === undefined));
    if (variant) {
      $('#stock-info').text(`Stock: ${variant.stock}`);
      $('#variant-id-field').val(variant.id);
      $('#add-to-cart-btn').prop('disabled', variant.stock <= 0);
      if (variant.image_url) $('#variant-image').attr('src', variant.image_url);
    } else {
      $('#stock-info').text('Variant not available');
      $('#variant-id-field').val('');
      $('#add-to-cart-btn').prop('disabled', true);
    }
  }

  $('.color-radio').off('change').on('change', function() {
    const color = $(this).val();
    $('#selected-color').text(color);
    updateSizes(color, true);
    $('#color-error').hide();
  });

  $('#variant-selection-form').off('submit').on('submit', function(e) {
    const selectedColor = $('.color-radio:checked').length > 0;
    const sizeSectionVisible = $('#size-options').closest('.mb-4').is(':visible');
    const selectedSize = !sizeSectionVisible || $('.size-radio:checked').length > 0;

    if (!selectedColor) $('#color-error').show();
    if (sizeSectionVisible && !selectedSize) $('#size-error').show();

    if (!selectedColor || !selectedSize) {
      e.preventDefault();
      e.stopPropagation();
    }
  });

  if (variants.length > 0) {
    const firstColor = variants[0].color;
    $('#selected-color').text(firstColor);
    $(`.color-radio[value="${firstColor}"]`).prop('checked', true).trigger('change');
  }
}

document.addEventListener('turbo:load', initializeVariantSelection);
document.addEventListener('DOMContentLoaded', initializeVariantSelection);
if (document.readyState === 'complete') initializeVariantSelection();
</script>

<!-- CSS -->
<style>
.description {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
  word-break: break-word;
  transition: max-height 0.3s ease;
}

/* collapsed = show limited lines */
.description.collapsed {
  -webkit-line-clamp: 3; /* adjust lines as needed */
  max-height: 4.5em;
}

/* expanded = show full text */
.description.expanded {
  -webkit-line-clamp: unset;
  max-height: none;
}

/* adjust for larger screens */
@media (min-width: 768px) {
  .description.collapsed {
    -webkit-line-clamp: 5;
    max-height: 7.5em;
  }
}

/* Variant selection CSS (existing) */
.grid-template-columns {
  display: grid;
  gap: 0.5rem;
  grid-template-columns: repeat(auto-fit, minmax(50px, 1fr));
}

.grid-template-columns input[type="radio"] + label {
  display: inline-block;
  text-align: center;
  padding: 6px 0;
  border: 1px solid #ccc;
  border-radius: 999px;
  background-color: #fff;
  color: #333;
  font-weight: 500;
  cursor: pointer;
  min-width: 50px;
  transition: all 0.2s ease-in-out;
}

.grid-template-columns input[type="radio"].btn-check:checked + label {
  border: 2px solid #000;
  background-color: #fff;
  color: #000;
}

.color-radio + label {
  border-radius: 4px;
  overflow: hidden;
  border: 2px solid transparent;
}

.color-radio:checked + label {
  border-color: #000;
}

.breadcrumb {
  background: transparent;
  padding: 0;
  margin-bottom: 1rem;
}
</style>
